{
  "name": "businesslife",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "npm run build:engine && tsc -p tsconfig.backend.build.json && node backend-dist/server.js",
    "build": "npm run build:engine && tsc -b && vite build",
    "build:engine": "node scripts/build-engine.mjs",
    "typecheck:backend": "tsc -p tsconfig.backend.json --noEmit",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify": "node scripts/verify-integrity.mjs && node scripts/verify-auth.mjs && npx tsx scripts/verify-scoring.ts && npx tsx scripts/verify-determinism.ts && npx tsx scripts/verify-cash-timing.ts && node scripts/verify-contrast.mjs && npx tsx scripts/verify-statements.ts && npx tsx scripts/verify-render.tsx && npx tsx scripts/verify-centres.ts && npx tsx scripts/verify-replay.ts && npx tsx scripts/verify-legit-play.ts",
    "verify:api": "node scripts/verify-integrity.mjs",
    "verify:auth": "node scripts/verify-auth.mjs",
    "verify:scoring": "npx tsx scripts/verify-scoring.ts",
    "verify:determinism": "npx tsx scripts/verify-determinism.ts",
    "verify:cash": "npx tsx scripts/verify-cash-timing.ts",
    "verify:statements": "npx tsx scripts/verify-statements.ts",
    "verify:contrast": "node scripts/verify-contrast.mjs",
    "verify:render": "npx tsx scripts/verify-render.tsx",
    "verify:centres": "npx tsx scripts/verify-centres.ts",
    "verify:replay": "npx tsx scripts/verify-replay.ts",
    "verify:legit": "npx tsx scripts/verify-legit-play.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.64.0",
    "motion": "^14.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
