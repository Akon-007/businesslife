# Copy to .env (or export in your shell / deploy settings). Nothing here is a
# secret that should be committed.

# --- API -------------------------------------------------------------------
PORT=8788
HOST=127.0.0.1

# --- Storage ---------------------------------------------------------------
# This file is a template. Copy it to `.env` (gitignored) — the API loads that
# file at boot, and any variable already in the environment wins over it.
# Leave the URL unset to run on the JSON file store (development default).
# Supabase: dashboard -> Database -> Connection string -> URI (pick the pooler).
#   transaction pooler (6543) for serverless, session pooler (5432) for a long-
#   running server. URL-encode the password, keep ?sslmode=require.
# SUPABASE_DB_URL=postgresql://postgres.abcdefgh:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?sslmode=require
# Neon also works (pooled host, contains -pooler):
#   NEON_DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# PGPOOL_MAX=8
# DB_STATEMENT_TIMEOUT_MS=20000
# Only for a proxy you control with a self-signed certificate:
# DB_SSL_INSECURE=false

# --- Security --------------------------------------------------------------
# Instructor accounts need this code at registration; without it the portal
# falls back to a dev session that is disabled in production.
# INSTRUCTOR_CODE=change-me
# Admin console key for operators and scripts (an admin *role* does not need it).
# ADMIN_KEY=change-me-too
# Dev sign-in is disabled automatically when NODE_ENV=production.
# ALLOW_DEV_LOGIN=false

# --- AI gateway ------------------------------------------------------------
# Optional. Without a key the advisor answers from the rules engine only.
# OPENAI_API_KEY=
# LLM_PROVIDER=openai
